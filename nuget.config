<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Jellyfin official NuGet feed -->
    <add key="jellyfin" value="https://nuget.pkg.github.com/jellyfin/index.json" />
    <!-- Emby/MediaBrowser NuGet feed -->
    <add key="emby" value="https://nuget.pkg.github.com/MediaBrowser/index.json" />
    <!-- Official NuGet feed -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  
  <packageSourceCredentials>
    <jellyfin>
      <add key="Username" value="user" />
      <add key="ClearTextPassword" value="${GITHUB_TOKEN}" />
    </jellyfin>
    <emby>
      <add key="Username" value="user" />
      <add key="ClearTextPassword" value="${GITHUB_TOKEN}" />
    </emby>
  </packageSourceCredentials>
  
  <packageRestore>
    <add key="enabled" value="True" />
  </packageRestore>
</configuration>
